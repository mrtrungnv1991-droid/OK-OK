# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Main Express/Vite server port (Default: 3000)
PORT=3000

# NODE_ENV: Application environment (development | production | test)
NODE_ENV=development

# JWT_SECRET: Cryptographic secret used for signing & verifying JWT authentication tokens (HMAC-SHA256).
# Must be a high-entropy string (min 32 characters in production).
JWT_SECRET=cyberpool-dev-jwt-secret-key-32b-min-2026!

# ENCRYPTION_KEY: Secret key for AES-256-GCM authenticated credential encryption vault.
# Must be set to a secure 32+ byte string in production.
ENCRYPTION_KEY=cyberpool-dev-vault-secret-key-32b-min-2026!

# SOURCE_CONNECTOR_SECRET_KEY: Secondary encryption secret for enterprise connector cookies/tokens.
SOURCE_CONNECTOR_SECRET_KEY=cyberpool-dev-connector-secret-key-32b-min-2026!

# VIETQR_WEBHOOK_SECRET: Secret for HMAC-SHA256 signature verification on VietQR payment webhooks.
# Enforced in all environments (constant-time verification).
VIETQR_WEBHOOK_SECRET=CYBER_VIETQR_SECRET_KEY_SECURE_2026!

# TELCO_WEBHOOK_SECRET: Secret for HMAC-SHA256 signature verification on Telco card callback webhooks.
TELCO_WEBHOOK_SECRET=CYBER_TELCO_SECRET_KEY_SECURE_2026!

# CARD24H_PARTNER_ID & CARD24H_PARTNER_KEY: Card24h.com Auto Scratch Card Charging API credentials
CARD24H_PARTNER_ID=16654919157
CARD24H_PARTNER_KEY=bc3299820230bb1ed2b2b729cac744e3

# FASTAPI_PORT: Optional port for Python FastAPI anti-fraud microservice (Default: 8000)
FASTAPI_PORT=8000

# CORS_ORIGINS: Comma-separated list of allowed origins for FastAPI CORS middleware (No wildcard with credentials)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173"
