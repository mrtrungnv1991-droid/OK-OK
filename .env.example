# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Main Express/Vite server port (Default: 3000)
PORT=3000

# NODE_ENV: Application environment (development | production | test)
NODE_ENV=development

# JWT_SECRET: Cryptographic secret used for signing & verifying JWT authentication tokens (HMAC-SHA256).
# Must be a high-entropy string (min 32 characters in production).
JWT_SECRET=cyberpool-dev-jwt-secret-key-32b-min-2026!

# ENCRYPTION_KEY: Secret key for AES-256-GCM authenticated credential encryption vault.
# Must be set to a secure 32+ byte string in production.
ENCRYPTION_KEY=cyberpool-dev-vault-secret-key-32b-min-2026!

# SOURCE_CONNECTOR_SECRET_KEY: Secondary encryption secret for enterprise connector cookies/tokens.
SOURCE_CONNECTOR_SECRET_KEY=cyberpool-dev-connector-secret-key-32b-min-2026!

# VIETQR_WEBHOOK_SECRET: Secret for HMAC-SHA256 signature verification on VietQR payment webhooks.
# Must be set to a private secure key in production.
VIETQR_WEBHOOK_SECRET=

# TELCO_WEBHOOK_SECRET: Secret for HMAC-SHA256 signature verification on Telco card callback webhooks.
TELCO_WEBHOOK_SECRET=

# CARD24H_PARTNER_ID & CARD24H_PARTNER_KEY: Card24h.com Auto Scratch Card Charging API credentials
CARD24H_PARTNER_ID=
CARD24H_PARTNER_KEY=
CARD24H_WALLET_ID=

# PAYMENT_PROVIDER_WEBHOOK_SECRET: Shared secret for external automated payment provider callbacks
PAYMENT_PROVIDER_WEBHOOK_SECRET=

# ============================================================================
# CYBERPOOL CRYPTOGATE — direct-to-wallet multi-network crypto deposit gateway
# (TRON / BSC / POLYGON / SOLANA USDT + LTC). Addresses are PUBLIC receiving
# wallets (not secrets). On-chain detection via public RPCs (TronGrid,
# publicnode, Solana mainnet, BlockCypher) — no provider API key required.
# ============================================================================
CRYPTOGATE_TRON_ADDRESS=TVhJziSD2nm9kD4pSoGBErJTgGiSVdgZ3z
CRYPTOGATE_BSC_ADDRESS=0x3202a720d192b93574b68f9246688002c6e3c884
CRYPTOGATE_POLYGON_ADDRESS=
CRYPTOGATE_SOLANA_ADDRESS=Fbpw6F85fxF1XivW95nTN2Ha7FhxnatXwG4e1z4ZDq9H
CRYPTOGATE_LTC_ADDRESS=LWYGurq3FqYbP4BxL5f8CMgJf8stVuXDP7
CRYPTOGATE_BINANCE_ID=159582002
# Optional provider merchant credentials (currently stored+masked, NOT used to
# credit — blockchain is the only source of truth until official API docs are
# confirmed). Fill when the provider's API spec is verified:
CRYPTOGATE_MERCHANT_ID=
CRYPTOGATE_API_KEY=
CRYPTOGATE_API_BASE=

# FASTAPI_PORT: Optional port for Python FastAPI anti-fraud microservice (Default: 8000)
FASTAPI_PORT=8000

# CORS_ORIGINS: Comma-separated list of allowed origins for FastAPI CORS middleware (No wildcard with credentials)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173"
